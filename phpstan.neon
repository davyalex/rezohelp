includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    # Lit le contenu des méthodes casts() pour typer les attributs (enums, dates…)
    parseModelCastsMethod: true
