# =============================================================================
# Rezohelp — variables d'environnement
# Copier ce fichier en .env puis lancer : php artisan key:generate
# Ne jamais commiter le fichier .env (identifiants réels).
# =============================================================================

# --- Application --------------------------------------------------------------
APP_NAME=Rezohelp
# local | testing | production
APP_ENV=local
APP_KEY=
# Toujours false en production
APP_DEBUG=true
APP_URL=http://localhost:8000

# Langue et fuseau : français, heure d'Abidjan (UTC+0, sans heure d'été)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Abidjan

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Journaux -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (MySQL 8, utf8mb4) ---------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rezohelp
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions et files : en base (une éviction Memcached déconnecterait) ------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (HTTPS)
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database

# --- Cache : Memcached (extension php-memcached + serveur) --------------------
# Si l'extension est absente, l'application bascule automatiquement sur « file ».
CACHE_STORE=memcached
CACHE_PREFIX=rezohelp
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Courriel (facultatif : l'identifiant est le téléphone) -------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@rezohelp.ci"
MAIL_FROM_NAME="${APP_NAME}"

# --- Compte administrateur créé par le seeder ---------------------------------
# Numéro au format national ou international ; il est normalisé en E.164.
ADMIN_TELEPHONE=
ADMIN_PAYS_CODE=CI
ADMIN_NOM=Administrateur
# 8 caractères minimum ; à changer à la première connexion
ADMIN_MOT_DE_PASSE=

# =============================================================================
# Services externes — drivers
# En local et en test : fake / log (aucun appel réseau).
# =============================================================================

# --- Paiement : fake | cinetpay -----------------------------------------------
PAIEMENT_DRIVER=fake
# Clé HMAC des webhooks simulés par le driver fake
PAIEMENT_FAKE_SECRET=secret-paiement-fake
# CinetPay (Orange Money, MTN MoMo, Moov Money, Wave, carte)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Clé secrète utilisée pour vérifier l'en-tête x-token des notifications
CINETPAY_SECRET=
CINETPAY_URL=https://api-checkout.cinetpay.com/v2

# --- SMS : log | orange | twilio ----------------------------------------------
# « log » écrit les SMS (et les codes OTP) dans storage/logs/sms.log
SMS_DRIVER=log
SMS_LOG_CHANNEL=sms
# Orange SMS API (OAuth2 client credentials)
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Numéro expéditeur enregistré chez Orange, ex. +2250000
ORANGE_SMS_EXPEDITEUR=
ORANGE_SMS_NOM_EXPEDITEUR=Rezohelp
ORANGE_SMS_COUT_FCFA=25
# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_EXPEDITEUR=
TWILIO_COUT_FCFA=50

# --- Veille IA (Google Drive) : fake | google_drive ---------------------------
# « fake » lit les CSV de tests/Fixtures/veille
VEILLE_DRIVE_DRIVER=fake
# Chemin absolu du fichier JSON du compte de service Google (hors du dépôt)
GOOGLE_DRIVE_FICHIER_IDENTIFIANTS=
# Identifiant du dossier « Offres Emploi Abidjan », partagé avec le compte de service
GOOGLE_DRIVE_DOSSIER_ID=

# --- IA (réécriture des cartes, score de fiabilité) : fake | claude -----------
IA_DRIVER=fake
CLAUDE_API_KEY=
CLAUDE_MODELE=claude-haiku-5-5
# Effort d'analyse (low suffit pour noter une annonce), tentatives sur 429 / 529 / 5xx
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=4000
CLAUDE_TENTATIVES=3
CLAUDE_ATTENTE_MS=1000

VITE_APP_NAME="${APP_NAME}"
